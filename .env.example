# Database connection (SQLite file)
DATABASE_URL="file:./data/shifts.db"

# Server Port
PORT=3000

# Server Timezone
TZ="Europe/Amsterdam"

# Authentik Reverse Proxy Integration
# In production behind SWAG/Nginx reverse proxy, Authentik automatically forwards:
# X-authentik-email, X-authentik-name, X-authentik-username, X-authentik-groups.
#
# Development Mock Identity (used when not running behind Authentik proxy):
DEV_USER_USERNAME="developer"
DEV_USER_NAME="Developer"
DEV_USER_EMAIL="developer@example.com"
